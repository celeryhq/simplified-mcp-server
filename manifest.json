  "user_config": {
    "api_key": {
      "type": "string",
      "title": "Api Key",
      "description": "Simplified Api Key",
      "default": "API_TOKEN",
      "required": true,
      "sensitive": true
    },
    "base_path": {
      "type": "string",
      "title": "Base path",
      "description": "Simplified Api Base Path",
      "required": true,
      "sensitive": false,
      "default": "https://api.simplified.com"
